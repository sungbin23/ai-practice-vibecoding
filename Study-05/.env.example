# 작성일: 2026-11-25 17:45 (수정됨 2026-11-25 18:17)
# 이 파일을 .env 로 복사해 키를 채우세요. .env 는 git 에 올라가지 않습니다.
# 키가 없거나 비어 있으면 데모 모드(샘플 분석)로 동작합니다.
OPENROUTER_API_KEY=

# (선택) 사용할 모델. 기본값: deepseek/deepseek-chat-v3.1:free
# MODEL=deepseek/deepseek-chat-v3.1:free

# (선택) 서버 포트. 기본값: 3000
# PORT=3000

# (선택) PDF 요약 앱(npm run pdf) 포트. 기본값: 3001
# PDF_PORT=3001
