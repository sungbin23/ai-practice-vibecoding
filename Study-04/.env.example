# 작성일: 2026-11-25 03:05
# OpenRouter API 키 설정 예시 파일입니다. 이 파일은 git에 올라가도 되는 "견본"입니다.
#
# 키 넣는 법
# 1. https://openrouter.ai 에 로그인 → 오른쪽 위 프로필 → Keys → [Create API Key]
# 2. 이 파일을 같은 폴더에 ".env" 이름으로 복사합니다.
#      PowerShell: Copy-Item .env.example .env
#      Git Bash  : cp .env.example .env
# 3. .env 파일의 OPENROUTER_API_KEY= 뒤에 발급받은 키(sk-or-v1-로 시작)를 붙여 넣습니다.
#      예) OPENROUTER_API_KEY=sk-or-v1-0123abcd...
# 4. 서버를 다시 시작하면 데모 모드가 꺼지고 실제 모델을 호출합니다.
#
# 키를 비워 두면 앱은 "데모 모드"(샘플 재료·샘플 레시피)로 실행됩니다.
# .env 는 .gitignore 에 들어 있으므로 커밋되지 않습니다. 키를 다른 곳에 붙여 넣지 마세요.

OPENROUTER_API_KEY=

# (선택) 무료 모델이 사라졌을 때 다른 모델 이름으로 바꿀 수 있습니다.
# VISION_MODEL=google/gemma-3-27b-it:free
# TEXT_MODEL=deepseek/deepseek-chat-v3.1:free

# (선택) 서버 포트, 키가 있어도 데모 모드 강제(1)
# PORT=3000
# DEMO_MODE=1
